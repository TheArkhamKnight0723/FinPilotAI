# ─────────────────────────────────────────────────────────────
# FinPilot AI – Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME="FinPilot AI"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (PostgreSQL) – not yet connected
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finpilot_db

# AI / LLM
GEMINI_API_KEY=your-gemini-api-key

# External Market Data
MARKET_DATA_API_KEY=your-market-data-api-key

# Logging
LOG_LEVEL=INFO
