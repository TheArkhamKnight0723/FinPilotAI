# FinPilot AI - Environment Configuration Example

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL)
POSTGRES_USER=finpilot_user
POSTGRES_PASSWORD=finpilot_password
POSTGRES_DB=finpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finpilot_user:finpilot_password@localhost:5432/finpilot_db

# Security & Auth
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Models & LLM Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# External Market Data APIs
MARKET_DATA_API_KEY=your-market-data-api-key
